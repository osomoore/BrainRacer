{
  "name": "brainracer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run assets",
    "dev": "vite",
    "dev:questions": "vite --mode questions",
    "build": "npm run assets && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/vitest.mjs",
    "e2e": "playwright test",
    "assets": "tsx scripts/build-assets.ts",
    "jbq:data": "tsx scripts/jbqData.ts",
    "audio:render": "tsx scripts/renderAudio.ts",
    "audio:workshop": "tsx scripts/renderWorkshopAudio.ts",
    "art:shapes": "tsx scripts/art/exportShapes.ts",
    "art:paint": "tsx scripts/art/paint.ts"
  },
  "dependencies": {
    "@tonejs/midi": "2.0.28",
    "phaser": "3.90.0",
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
